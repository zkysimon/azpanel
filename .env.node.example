# Copy to .env.node. Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-characters
DATA_DIR=./data
HOST=127.0.0.1
PORT=3000
# Initial administrator is created only when the user table is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# Cloud writes are disabled by default. Enable deliberately for real management.
AZURE_ALLOW_WRITES=false
# Set true behind an HTTPS reverse proxy. Local HTTP development uses false.
COOKIE_SECURE=false
# Global Azure request spacing; minimum 1000 ms. No automatic account scanning.
AZURE_REQUEST_INTERVAL_MS=1500
# Avatar source: gravatar (hash email to gravatar.com), local (offline initials), or none.
AVATAR_SOURCE=gravatar
